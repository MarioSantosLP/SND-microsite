        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;theme&#39;: &#39;base&#39;, &#39;themeVariables&#39;: {&#39;fontFamily&#39;: &#39;Segoe UI, Arial, sans-serif&#39;, &#39;fontSize&#39;: &#39;16px&#39;, &#39;primaryColor&#39;: &#39;#ffffff&#39;, &#39;primaryTextColor&#39;: &#39;#1e293b&#39;, &#39;primaryBorderColor&#39;: &#39;#94a3b8&#39;, &#39;lineColor&#39;: &#39;#64748b&#39;, &#39;clusterBkg&#39;: &#39;#f8fafc&#39;, &#39;clusterBorder&#39;: &#39;#cbd5e1&#39;, &#39;edgeLabelBackground&#39;: &#39;#ffffff&#39;}, &#39;flowchart&#39;: {&#39;htmlLabels&#39;: true, &#39;curve&#39;: &#39;linear&#39;, &#39;padding&#39;: 15, &#39;nodeSpacing&#39;: 45, &#39;rankSpacing&#39;: 65}}}%%\nflowchart LR\n    USER([\&quot;User\&quot;])\n    ADMIN([\&quot;Admin\&quot;])\n    WEB[\&quot;&lt;div style=&#39;width:180px;height:120px;display:flex;align-items:flex-end;justify-content:center;text-align:center&#39;&gt;Website&lt;/div&gt;\&quot;]\n\n    subgraph MGMT[\&quot;Management VM\&quot;]\n        PROXY[\&quot;&lt;div style=&#39;width:180px;height:120px;display:flex;align-items:flex-end;justify-content:center;text-align:center&#39;&gt;Reverse Proxy&lt;/div&gt;\&quot;]\n        API[\&quot;&lt;div style=&#39;width:180px;height:120px;display:flex;align-items:flex-end;justify-content:center;text-align:center&#39;&gt;Backend API&lt;/div&gt;\&quot;]\n        DB[(\&quot;&lt;div style=&#39;width:180px;height:120px;display:flex;align-items:flex-end;justify-content:center;text-align:center&#39;&gt;Database&lt;/div&gt;\&quot;)]\n\n        subgraph WORKER[\&quot;Worker\&quot;]\n            direction LR\n\n            subgraph PLAN[\&quot;1. Plan\&quot;]\n                direction TB\n                RAG[\&quot;&lt;div style=&#39;width:180px;height:120px;display:flex;align-items:flex-end;justify-content:center;text-align:center&#39;&gt;RAG&lt;/div&gt;\&quot;]\n                PLANNER[\&quot;&lt;div style=&#39;width:180px;height:120px;display:flex;align-items:flex-end;justify-content:center;text-align:center&#39;&gt;Planner&lt;/div&gt;\&quot;]\n                PV[\&quot;&lt;div style=&#39;width:180px;height:120px;display:flex;align-items:flex-end;justify-content:center;text-align:center&#39;&gt;Plan Validator&lt;/div&gt;\&quot;]\n            end\n\n            CONFIRM{{\&quot;User Confirmation\&quot;}}\n\n            subgraph CONFIG[\&quot;2. Config\&quot;]\n                direction TB\n                CFG[\&quot;&lt;div style=&#39;width:180px;height:120px;display:flex;align-items:flex-end;justify-content:center;text-align:center&#39;&gt;Config Generator&lt;/div&gt;\&quot;]\n            end\n\n            subgraph DEPLOY[\&quot;3. Deploy\&quot;]\n                direction TB\n                CREATE[\&quot;&lt;div style=&#39;width:180px;height:120px;display:flex;align-items:flex-end;justify-content:center;text-align:center&#39;&gt;Create VMs&lt;/div&gt;\&quot;]\n                CONFIGURE[\&quot;&lt;div style=&#39;width:180px;height:120px;display:flex;align-items:flex-end;justify-content:center;text-align:center&#39;&gt;Configure VMs&lt;/div&gt;\&quot;]\n                DV[\&quot;&lt;div style=&#39;width:180px;height:120px;display:flex;align-items:flex-end;justify-content:center;text-align:center&#39;&gt;Deployment Validator&lt;/div&gt;\&quot;]\n            end\n        end\n    end\n\n    MODEL[\&quot;&lt;div style=&#39;width:180px;height:120px;display:flex;align-items:flex-end;justify-content:center;text-align:center&#39;&gt;Model&lt;/div&gt;\&quot;]\n\n    subgraph PROXMOX[\&quot;Proxmox\&quot;]\n        NET[\&quot;&lt;div style=&#39;width:180px;height:120px;display:flex;align-items:flex-end;justify-content:center;text-align:center&#39;&gt;Network VMs&lt;/div&gt;\&quot;]\n    end\n\n    USER --&gt; WEB\n    ADMIN --&gt; WEB\n    WEB &lt;--&gt; PROXY\n    PROXY &lt;--&gt; API\n    API &lt;--&gt;|\&quot;jobs / steps\&quot;| DB\n    WORKER &lt;--&gt;|\&quot;jobs / steps\&quot;| DB\n    WORKER &lt;--&gt;|\&quot;Planner only\&quot;| MODEL\n    WORKER --&gt; PROXMOX\n\n    RAG --&gt; PLANNER\n    PLANNER --&gt; PV\n    PV -.-&gt;|\&quot;errors\&quot;| PLANNER\n    PLAN --&gt; CONFIRM\n    CONFIRM --&gt; CONFIG\n    CONFIRM -.-&gt;|\&quot;Refine\&quot;| PLAN\n    CONFIG --&gt; DEPLOY\n    CREATE --&gt; CONFIGURE\n    CONFIGURE --&gt; DV\n    CONFIGURE -.-&gt;|\&quot;retry once\&quot;| CREATE\n    DEPLOY -.-&gt;|\&quot;repair\&quot;| PLAN\n\n    classDef actor fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d\n    classDef front fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a\n    classDef svc fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0c4a6e\n    classDef store fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f\n    classDef ai fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#4c1d95\n    classDef step fill:#ffffff,stroke:#64748b,stroke-width:1.5px,color:#1e293b\n    classDef decision fill:#ffedd5,stroke:#ea580c,stroke-width:2px,color:#7c2d12\n    classDef infra fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a\n    classDef depth filter:drop-shadow(5px 5px 0px #cbd5e1)\n\n    class USER,ADMIN actor\n    class WEB front\n    class PROXY,API svc\n    class DB store\n    class PLANNER,MODEL ai\n    class RAG,PV,CFG,CREATE,CONFIGURE,DV step\n    class CONFIRM decision\n    class NET infra\n    class WEB,PROXY,API,DB,RAG,PLANNER,PV,CFG,CREATE,CONFIGURE,DV,MODEL,NET depth\n\n    style MGMT fill:#f8fafc,stroke:#94a3b8,stroke-width:2px,stroke-dasharray:6 4\n    style WORKER fill:#ffffff,stroke:#475569,stroke-width:2px\n    style PLAN fill:#faf5ff,stroke:#c4b5fd\n    style CONFIG fill:#f0f9ff,stroke:#7dd3fc\n    style DEPLOY fill:#f0fdfa,stroke:#5eead4\n    style PROXMOX fill:#f0fdfa,stroke:#0d9488,stroke-width:2px\n\n    linkStyle default stroke:#64748b,stroke-width:2px\n    linkStyle 10,18 stroke:#dc2626,stroke-width:2px\n    linkStyle 13 stroke:#ea580c,stroke-width:2px\n    linkStyle 17 stroke:#d97706,stroke-width:2px&quot;,&#xa;  &quot;config&q